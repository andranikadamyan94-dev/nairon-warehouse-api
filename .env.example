# Copy to .env and fill in real values. Secrets must never be committed.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_warehouse
JWT_SECRET=change-me
PORT=3006
INTERNAL_SECRET=change-me
HR_SERVICE_URL=http://localhost:3001
FINANCE_API_URL=http://localhost:3005
CRM_API_URL=http://localhost:3003
FRONTEND_URL=http://localhost:4003
USERS_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_auth
EMAIL_PASS=change-me
EMAIL_USER=notifications@example.com

# Optional Prisma pool caps (defaults: own DB 8, users DB 4) — see prisma.service.ts
DB_POOL_LIMIT=8
USERS_DB_POOL_LIMIT=4

# Delegated AI tokens (JWTs carrying `act`, minted by auth-api for goal and
# workflow runs; ai-api and other services reach this one directly with them).
# Off unless exactly "true"; off, any such token is refused 403. On, one with
# scope "read" may make GET requests only, in the organisation it was issued
# for, and never on a GET marked @NotForDelegatedTokens(). Normal tokens are
# never affected.
DELEGATED_TOKENS_READONLY=false

# Delegated WRITE tokens (Nairon AI V3.4 standing approvals). Off unless exactly
# "true"; off, a goal:write:* token is refused by the read-only rule as before.
# On, it is accepted only on a handler marked @DelegatedWriteRoute(<its tool>)
# (here: POST /reservations and POST /reservations/preflight/create, for
# warehouse.reservations.create), with X-Entity-ID = its entityId, only on its
# signed target (the body's task, project iff frozen, one item and quantity), HR membership
# asked over the internal channel (needs INTERNAL_SECRET + HR_SERVICE_URL), the
# AI switches and view_warehouse|manage_reservations|manage_warehouse held
# literally there, and one create per token. Independent of
# DELEGATED_TOKENS_READONLY.
DELEGATED_TOKENS_WRITE=false
