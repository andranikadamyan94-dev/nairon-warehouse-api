NODE_ENV=development

DATABASE_URL=postgresql://nairon_warehouse:your_password_here@localhost:5432/nairon_warehouse
# Shared auth/users DB — read directly for authorization and to resolve
# notification recipients (users holding a given permission).
USERS_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nairon_auth

PORT=10000

INTERNAL_SECRET=change_me
HR_SERVICE_URL=http://localhost:3001
FINANCE_API_URL=http://localhost:3005
CRM_API_URL=http://localhost:3003

# Warehouse client base — used to build the links inside notifications.
FRONTEND_URL=http://localhost:4003

# Notification email. Without these, in-app notifications still work but no mail
# is sent (logged as a warning at boot).
EMAIL_USER=
EMAIL_PASS=
