# Copy to .env and fill in real values. Secrets must never be committed.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_warehouse
JWT_SECRET=change-me
PORT=3006
INTERNAL_SECRET=change-me
HR_SERVICE_URL=http://localhost:3001
FINANCE_API_URL=http://localhost:3005
CRM_API_URL=http://localhost:3003
FRONTEND_URL=http://localhost:4003
USERS_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nairon_auth
EMAIL_PASS=change-me
EMAIL_USER=notifications@example.com

# Optional Prisma pool caps (defaults: own DB 8, users DB 4) — see prisma.service.ts
DB_POOL_LIMIT=8
USERS_DB_POOL_LIMIT=4
