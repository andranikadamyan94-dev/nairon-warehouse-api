generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  CONSUMABLE
  ASSET
}

enum ResourceReturnStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  AVAILABLE
  MAINTENANCE
  DAMAGED
  RETIRED
}

enum ResourceReservationStatus {
  PENDING
  APPROVED
  PARTIALLY_ALLOCATED
  ALLOCATED
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReservationAllocationAction {
  ALLOCATED
  RELEASED
  REALLOCATED
  RETURNED
}

enum ProcurementOrderStatus {
  DRAFT
  ORDERED
  PENDING_FINANCE_APPROVAL
  FINANCE_APPROVED
  FINANCE_REJECTED
  /// Some but not all of the ordered quantity has arrived.
  PARTIALLY_RECEIVED
  RECEIVED
  /// Settled at less than the ordered quantity — the rest is not coming.
  /// Distinct from RECEIVED so reporting can tell a short settlement from a
  /// complete one.
  CLOSED_SHORT
  CANCELLED
}

/// Reserved for the prepayment (avans) work: an order will be able to carry a
/// prepayment settled up front and a balance settled once delivery closes.
/// Only BALANCE is used today.
enum ProcurementPaymentType {
  PREPAYMENT
  BALANCE
}

enum MaintenanceStatus {
  DRAFT
  PENDING_FINANCE
  FINANCE_APPROVED
  FINANCE_REJECTED
  IN_PROGRESS
  COMPLETED
}

enum ItemUnit {
  KG
  TONNE
  METER
  PIECE
  HOUR
}

model Item {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String
  code String? @unique

  type ItemType

  unit ItemUnit?

  quantity Float @default(0)

  /// Low-stock threshold. Alerts fire when quantity <= minQuantity.
  /// NULL means no alerting for this item, so the feature is opt-in rather than
  /// every item alerting the moment it reaches zero. CONSUMABLE only — an
  /// ASSET's availability derives from its individual Asset rows, not this
  /// counter, so a threshold here would be meaningless.
  minQuantity Float?

  /// Set when a low-stock alert has been sent, cleared when stock recovers
  /// above the threshold. This is what makes the alert fire once per breach
  /// instead of on every write while stock sits low — quantity is mutated from
  /// six different paths, several via increment/decrement inside transactions
  /// where the previous value isn't available to compare against.
  lowStockNotifiedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  assets Asset[]

  inventoryMovements InventoryMovement[]

  warehouseStock     WarehouseStock[]
  stockTransferItems StockTransferItem[]

  resourceReservations ResourceReservation[]

  procurementOrderItems ProcurementOrderItem[]

  supplierItems SupplierItem[]

  categoryId Int?

  category ItemCategory? @relation(fields: [categoryId], references: [id])

  @@index([type])
}

model Asset {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String?

  itemId Int

  serialNumber String? @unique

  status AssetStatus @default(AVAILABLE)

  responsibleUserId Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  maintenanceRecords MaintenanceRecord[]

  allocations ReservationAllocation[]

  responsibilities AssetResponsibility[]

  allocationHistory ReservationAllocationHistory[]

  @@index([itemId])
  @@index([status])
}

model InventoryMovement {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  itemId Int

  quantity Float

  type String

  taskId Int?

  supplierId Int?

  performedBy Int?

  notes String?

  /// Sub-warehouse ledger dimension (#1989). NULL = the main warehouse — every
  /// pre-existing row and every main-pool operation keeps writing null, so
  /// history needed no repair.
  warehouseId Int?

  createdAt DateTime @default(now())

  // RELATIONS

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([warehouseId])
}

/// #1989 sub-warehouses. The MAIN row is identity only — its stock is and
/// stays Item.quantity (no WarehouseStock rows); PROJECT warehouses hold
/// stock in WarehouseStock and are replenished ONLY by transfer from main.
model Warehouse {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String
  code String @unique

  type WarehouseType @default(PROJECT)

  /// Responsible person (users-DB id).
  responsibleId Int?

  location String?

  status WarehouseStatus @default(ACTIVE)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backlogs     WarehouseBacklog[]
  stock        WarehouseStock[]
  transfersIn  StockTransfer[]      @relation("TransferTo")
  movements    InventoryMovement[]
  reservations ResourceReservation[]

  @@index([type])
  @@index([status])
}

enum WarehouseType {
  MAIN
  PROJECT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

/// A CRM backlog («նախագիծ» in the team's language) is served by exactly one
/// warehouse; a warehouse may serve many. Tasks resolve task→backlog→warehouse
/// and are BLOCKED when their backlog is unlinked (user's call, 2026-09-03).
model WarehouseBacklog {
  id Int @id @default(autoincrement())

  warehouseId Int
  /// CRM Backlog id — cross-service reference, validated at link time.
  backlogId   Int    @unique
  /// Name snapshot so lists don't need a CRM round-trip.
  backlogName String

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

/// Consumable stock held by a PROJECT warehouse (main = Item.quantity).
model WarehouseStock {
  id Int @id @default(autoincrement())

  warehouseId Int
  itemId      Int

  quantity Int @default(0)

  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@index([itemId])
}

/// Main → project-warehouse stock transfer (#1989): one DOCUMENT with many
/// item lines, mirroring the printed transfer-waybill form. Confirmed
/// atomically per line: main pool down, sub stock up, paired OUT/IN movements.
model StockTransfer {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  toWarehouseId Int

  transferDate DateTime @default(now())

  comment String?

  createdBy Int?
  createdAt DateTime @default(now())

  toWarehouse Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items       StockTransferItem[]

  @@index([toWarehouseId])
}

model StockTransferItem {
  id Int @id @default(autoincrement())

  transferId Int
  itemId     Int
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@index([itemId])
}

model ResourceReservation {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  itemId Int

  taskId      Int?
  projectId   Int?
  projectName String?

  entityId   Int?
  entityName String?

  quantity Int

  /// Task-side acceptance (2026-09-01 handshake): how much of the ISSUED
  /// quantity the task has confirmed receiving. Invariant accepted ≤ issued ≤
  /// requested; full acceptance of the requested quantity flips the
  /// reservation to COMPLETED — the status's first and only setter.
  acceptedQuantity  Int     @default(0)
  /// The task user's explanation when accepting less than what was issued
  /// (broken delivery, over-estimated request, …). Appended per acceptance and
  /// deliberately surfaced to warehouse staff.
  acceptanceComment String?

  status ResourceReservationStatus @default(PENDING)

  /// Which warehouse serves this reservation (#1989). NULL = main pool
  /// (Item.quantity) — every pre-1989 reservation and every non-task flow.
  /// Set from the task's backlog link at create; issuance, reclaims and
  /// returns then debit/credit THIS warehouse's stock.
  warehouseId Int?

  startDate DateTime
  endDate   DateTime?

  notes String?

  replacedByReservationId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  replacedBy ResourceReservation?  @relation("ReservationReplacement", fields: [replacedByReservationId], references: [id])
  replaces   ResourceReservation[] @relation("ReservationReplacement")

  allocations ReservationAllocation[]

  allocationHistory ReservationAllocationHistory[]

  statusHistory ReservationStatusHistory[]

  returns ResourceReturn[]

  @@index([itemId])
  @@index([taskId])
  @@index([projectId])
  @@index([entityId])
  @@index([status])
  @@index([startDate, endDate])
}

model ReservationStatusHistory {
  id Int @id @default(autoincrement())

  reservationId Int

  fromStatus ResourceReservationStatus?
  toStatus   ResourceReservationStatus

  previousQuantity Int?
  newQuantity      Int?

  performedBy Int?

  reason String?

  performedAt DateTime @default(now())

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([performedAt])
}

model ReservationAllocation {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int

  assetId Int?

  quantity Int @default(1)

  allocatedAt DateTime @default(now())

  allocatedBy Int?

  releasedAt DateTime?

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([assetId])
  @@index([releasedAt])
}

model ReservationAllocationHistory {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int

  assetId Int?

  action ReservationAllocationAction

  performedBy Int?

  notes String?

  performedAt DateTime @default(now())

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([assetId])
  @@index([action])
}

model Maintainer {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name           String
  phone          String?
  email          String?
  address        String?
  actingAddress  String?
  managers       Json?
  bankName       String?
  bankAccount    String?
  registryNumber String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceRecord {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  assetId Int

  maintainerId Int?

  status MaintenanceStatus @default(DRAFT)

  amount Float?

  /// Deposit the maintainer wants before starting. Raised as its own finance
  /// transfer when the job is submitted; the balance transfer covers the rest.
  prepaymentAmount Float?

  /// The balance transfer — kept on this field so every existing path that
  /// reads financeTransferId keeps working.

  financeTransferId    Int?
  prepaymentTransferId Int?

  /// Why finance turned the job down. See ProcurementOrder for the same field —
  /// finance sends this on the rejection callback and it was being discarded.
  financeRejectionReason String?

  startDate DateTime
  endDate   DateTime?

  type String?

  notes String?

  createdBy Int?

  createdAt DateTime @default(now())

  // RELATIONS

  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintainer Maintainer? @relation(fields: [maintainerId], references: [id])

  @@index([assetId])
  @@index([maintainerId])
  @@index([startDate, endDate])
}

model AssetResponsibility {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  assetId Int

  userId Int

  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  assignedBy Int?

  notes String?

  createdAt DateTime @default(now())

  // RELATIONS

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@index([releasedAt])
}

model Supplier {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name           String
  email          String?
  phone          String?
  address        String?
  actingAddress  String?
  managers       Json?
  bankName       String?
  bankAccount    String?
  registryNumber String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  procurementOrders  ProcurementOrder[]
  inventoryMovements InventoryMovement[]
  supplierItems      SupplierItem[]
}

model SupplierItem {
  id         Int   @id @default(autoincrement())
  supplierId Int
  itemId     Int
  unitPrice  Float

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, itemId])
  @@index([supplierId])
  @@index([itemId])
}

model ProcurementOrder {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  status ProcurementOrderStatus @default(DRAFT)

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes             String?
  /// Deposit the supplier requires before shipping. Raised as its own finance
  /// transfer at finalize; the balance transfer is what remains after it.
  prepaymentAmount  Float?
  createdBy         Int?
  financeTransferId Int?

  /// Why finance turned the order down. Finance has always sent this on the
  /// rejection callback; there was nowhere to put it, so the warehouse showed a
  /// red status and no reason, and the only way to find out was to ask finance.
  /// Cleared on approval and on resubmission so a stale reason cannot linger.
  financeRejectionReason String?

  /// Receipt/receivedAt of the FIRST delivery, kept so existing list views and
  /// the finance flow keep working unchanged. Per-delivery documents live on
  /// ProcurementDelivery.
  receiptUrl String?
  receivedAt DateTime?

  /// Set when the order was settled short — the outstanding quantity is not
  /// coming. Paired with status CLOSED_SHORT.
  closedShortAt     DateTime?
  closedShortReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      ProcurementOrderItem[]
  deliveries ProcurementDelivery[]
  payments   ProcurementPayment[]

  @@index([supplierId])
  @@index([status])
}

model ProcurementOrderItem {
  id      Int @id @default(autoincrement())
  orderId Int
  itemId  Int

  quantity  Float
  unitPrice Float?

  /// Cached rollup of this line's ProcurementDeliveryItem quantities. Derivable,
  /// but kept denormalised so list views and the "remaining" column don't have
  /// to aggregate deliveries on every read.
  receivedQuantity Float @default(0)

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deliveryItems ProcurementDeliveryItem[]

  @@index([orderId])
  @@index([itemId])
}

/// One physical delivery against an order. Orders can arrive in instalments,
/// and each instalment comes with its own receipt/waybill — which is why this
/// is a table rather than a counter on the order.
model ProcurementDelivery {
  id      Int @id @default(autoincrement())
  orderId Int

  receiptUrl String?
  notes      String?
  receivedBy Int?
  receivedAt DateTime @default(now())

  order ProcurementOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ProcurementDeliveryItem[]

  @@index([orderId])
}

model ProcurementDeliveryItem {
  id          Int @id @default(autoincrement())
  deliveryId  Int
  orderItemId Int

  quantity Float

  delivery  ProcurementDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem ProcurementOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([orderItemId])
}

/// A settlement against an order. Today an order has at most one BALANCE row;
/// the prepayment work will add a PREPAYMENT row settled before delivery.
/// Replaces the single ProcurementOrder.financeTransferId, which could not
/// represent more than one payment.
model ProcurementPayment {
  id      Int @id @default(autoincrement())
  orderId Int

  type   ProcurementPaymentType
  amount Float

  /// finance-api Transfer id. The finance callback identifies which payment it
  /// refers to by this, since both payments call back on the same order URL.
  financeTransferId Int?
  status            String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([financeTransferId])
}

model ItemCategory {
  id Int @id @default(autoincrement())

  name String

  entityId Int @default(1)

  parentId Int?

  position Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  parent ItemCategory? @relation("ItemCategoryHierarchy", fields: [parentId], references: [id])

  children ItemCategory[] @relation("ItemCategoryHierarchy")

  items Item[]

  @@index([entityId])
}

model ResourceReturn {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int
  reservation   ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  quantity Int

  status ResourceReturnStatus @default(PENDING)

  notes String?

  requestedBy Int?
  receivedBy  Int?

  requestedAt DateTime  @default(now())
  receivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([status])
}
