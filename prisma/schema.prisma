generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  CONSUMABLE
  ASSET
}

enum ResourceReturnStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AssetStatus {
  AVAILABLE
  MAINTENANCE
  DAMAGED
  RETIRED
}

enum ResourceReservationStatus {
  PENDING
  APPROVED
  PARTIALLY_ALLOCATED
  ALLOCATED
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReservationAllocationAction {
  ALLOCATED
  RELEASED
  REALLOCATED
  RETURNED
}

enum ProcurementOrderStatus {
  DRAFT
  /// Sent by procurement, waiting for approve_purchase_order before finance
  /// hears of it (2026-09-25).
  PENDING_APPROVAL
  ORDERED
  PENDING_FINANCE_APPROVAL
  FINANCE_APPROVED
  FINANCE_REJECTED
  /// Some but not all of the ordered quantity has arrived.
  PARTIALLY_RECEIVED
  RECEIVED
  /// Settled at less than the ordered quantity — the rest is not coming.
  /// Distinct from RECEIVED so reporting can tell a short settlement from a
  /// complete one.
  CLOSED_SHORT
  CANCELLED
}

/// Reserved for the prepayment (avans) work: an order will be able to carry a
/// prepayment settled up front and a balance settled once delivery closes.
/// Only BALANCE is used today.
enum ProcurementPaymentType {
  PREPAYMENT
  BALANCE
  /// Price correction after receipt (2026-09-22): the invoice came higher
  /// than what finance booked — the difference is a new expense.
  ADJUSTMENT
  /// The invoice came lower than what was booked — money to get back from
  /// the supplier, raised in finance as income.
  REFUND
}

enum MaintenanceStatus {
  DRAFT
  PENDING_FINANCE
  FINANCE_APPROVED
  FINANCE_REJECTED
  IN_PROGRESS
  COMPLETED
}

enum ItemUnit {
  KG
  TONNE
  METER
  PIECE
  HOUR
  /// 2026-09-13: տուփ / լիտր
  BOX
  LITER
  /// «մետր քառակուսի» (2026-09-23)
  SQUARE_METER
}

model Item {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String
  /// A second name for the same thing — the supplier's wording, a brand, the
  /// Russian/English term people also search by. Shown on hover in the list.
  secondaryName String?
  code String? @unique

  type ItemType

  unit ItemUnit?

  quantity Float @default(0)

  /// Low-stock threshold. Alerts fire when quantity <= minQuantity.
  /// NULL means no alerting for this item, so the feature is opt-in rather than
  /// every item alerting the moment it reaches zero. CONSUMABLE only — an
  /// ASSET's availability derives from its individual Asset rows, not this
  /// counter, so a threshold here would be meaningless.
  minQuantity Float?

  /// #2042 cost layer: the CURRENT unit cost (AMD), snapshotted onto every
  /// movement at write time. Manually maintained for now — the update policy
  /// (weighted average at receive, last price, …) is a pending decision, and
  /// changing it later only changes who writes this field.
  unitCost Float?

  /// Set when a low-stock alert has been sent, cleared when stock recovers
  /// above the threshold. This is what makes the alert fire once per breach
  /// instead of on every write while stock sits low — quantity is mutated from
  /// six different paths, several via increment/decrement inside transactions
  /// where the previous value isn't available to compare against.
  lowStockNotifiedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  assets Asset[]

  inventoryMovements InventoryMovement[]

  warehouseStock     WarehouseStock[]
  stockTransferItems StockTransferItem[]
  stockRequestItems  StockRequestItem[]
  estimateLines      ObjectEstimateLine[]

  resourceReservations ResourceReservation[]

  procurementOrderItems ProcurementOrderItem[]

  supplierItems SupplierItem[]
  requisitionLines PurchaseRequisitionLine[]

  categoryId Int?

  category ItemCategory? @relation(fields: [categoryId], references: [id])

  @@index([type])

  assetRequests AssetRequest[]
}

model Asset {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String?

  itemId Int

  serialNumber String? @unique

  status AssetStatus @default(AVAILABLE)

  /// #1989 wave 2: which warehouse holds this asset. NULL = main — every
  /// pre-existing row; assets move between pools via stock transfers.
  warehouseId Int?

  responsibleUserId Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  maintenanceRecords MaintenanceRecord[]

  allocations ReservationAllocation[]

  responsibilities AssetResponsibility[]

  custodies AssetCustody[]

  allocationHistory ReservationAllocationHistory[]

  @@index([itemId])
  @@index([status])
  @@index([warehouseId])
}

model InventoryMovement {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  itemId Int

  quantity Float

  type String

  taskId Int?

  supplierId Int?

  performedBy Int?

  notes String?

  /// Sub-warehouse ledger dimension (#1989). NULL = the main warehouse — every
  /// pre-existing row and every main-pool operation keeps writing null, so
  /// history needed no repair.
  warehouseId Int?

  /// #2042: the construction object this movement attributes to (via the
  /// task's object link, stamped at reservation create). One ledger row feeds
  /// both the task view and the object view — no double booking.
  objectId Int?

  /// #2042 cost freeze: the item's unit cost AT WRITE TIME (AMD) and the
  /// positive line value (|quantity| × unitCost). Never recomputed.
  unitCost  Float?
  totalCost Float?

  createdAt DateTime @default(now())

  // RELATIONS

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([warehouseId])
  @@index([objectId])
}

/// #1989 sub-warehouses. The MAIN row is identity only — its stock is and
/// stays Item.quantity (no WarehouseStock rows); PROJECT warehouses hold
/// stock in WarehouseStock and are replenished ONLY by transfer from main.
model Warehouse {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String
  code String @unique

  type WarehouseType @default(PROJECT)

  /// Responsible person (users-DB id).
  responsibleId Int?

  location String?

  status WarehouseStatus @default(ACTIVE)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backlogs      WarehouseBacklog[]
  stock         WarehouseStock[]
  transfersIn   StockTransfer[]      @relation("TransferTo")
  movements     InventoryMovement[]
  reservations  ResourceReservation[]
  employees     WarehouseEmployee[]
  assets        Asset[]
  stockRequests StockRequest[]

  @@index([type])
  @@index([status])
}

enum WarehouseType {
  MAIN
  PROJECT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

/// A CRM backlog («նախագիծ» in the team's language) is served by exactly one
/// warehouse; a warehouse may serve many. Tasks resolve task→backlog→warehouse
/// and are BLOCKED when their backlog is unlinked (user's call, 2026-09-03).
model WarehouseBacklog {
  id Int @id @default(autoincrement())

  warehouseId Int
  /// CRM Backlog id — cross-service reference, validated at link time.
  backlogId   Int    @unique
  /// Name snapshot so lists don't need a CRM round-trip.
  backlogName String

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

/// Consumable stock held by a PROJECT warehouse (main = Item.quantity).
model WarehouseStock {
  id Int @id @default(autoincrement())

  warehouseId Int
  itemId      Int

  quantity Float @default(0)

  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, itemId])
  @@index([itemId])
}

/// Main ↔ project-warehouse stock transfer (#1989): one DOCUMENT with many
/// item lines, mirroring the printed transfer-waybill form. Confirmed
/// atomically per line: source pool down, destination up, paired movements.
/// direction TO_SUB = main→sub (replenishment); TO_MAIN = sub→main (the
/// correction/return path). toWarehouseId is ALWAYS the sub involved.
model StockTransfer {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  toWarehouseId Int

  direction String @default("TO_SUB")

  transferDate DateTime @default(now())

  comment String?

  createdBy Int?
  createdAt DateTime @default(now())

  toWarehouse Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items       StockTransferItem[]

  @@index([toWarehouseId])
}

model StockTransferItem {
  id Int @id @default(autoincrement())

  transferId Int
  itemId     Int
  quantity   Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])

  @@index([transferId])
  @@index([itemId])
}

/// Warehouse staff membership (#1989 wave 2): membership decides WHICH
/// warehouses a user sees and operates; permissions still decide WHAT they
/// can do inside. manage_warehouses / manage_warehouse / superadmin see all.
model WarehouseEmployee {
  id Int @id @default(autoincrement())

  warehouseId Int
  /// users-DB id
  userId      Int

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, userId])
  @@index([userId])
}

/// A sub's resource request to main (#1989 wave 2): sub members file it,
/// main (manage_stock_transfers) approves — which executes a TO_SUB transfer
/// atomically — or rejects with a reason. Requester may cancel while pending.
model StockRequest {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  /// the requesting sub
  warehouseId Int

  status String @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED

  comment         String?
  rejectionReason String?

  createdBy Int?
  decidedBy Int?
  decidedAt DateTime?

  /// the transfer executed on approval
  transferId Int?

  createdAt DateTime @default(now())

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     StockRequestItem[]

  @@index([warehouseId])
  @@index([status])
}

model StockRequestItem {
  id Int @id @default(autoincrement())

  requestId Int
  itemId    Int
  quantity  Float

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// #2042 estimate (նախահաշիվ): planned material lines per construction object
/// (object ids live in CRM). Actuals come from the movement ledger; deviations
/// are pure computation over the two.
model ObjectEstimateLine {
  id Int @id @default(autoincrement())

  /// CRM ConstructionObject id (cross-service reference).
  objectId Int
  itemId   Int

  plannedQuantity Float
  /// Planned unit cost (AMD); planned value = quantity × this.
  plannedUnitCost Float?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([objectId, itemId])
  @@index([objectId])
}

model ResourceReservation {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  itemId Int

  taskId      Int?
  projectId   Int?
  projectName String?

  /// WHO ASKED — as the caller said at the time, and not to be trusted.
  ///
  /// Kept, and kept meaning exactly what it has always meant: a label the
  /// request body carried. Of the 83 rows here it is empty on 28. Of the 55
  /// that carry one and whose project can still be found: 46 agree with the
  /// project's company, 3 name the company that OWNS the stock, and 6 name
  /// neither. A field saying three different things depending on the row cannot
  /// be a scoping key, so nothing authorizes anything with it.
  /// requesterWorkspaceId below is the answer; this is the history.
  entityId   Int?
  entityName String?

  /// WHO ASKED — derived, and pinned when the reservation was made.
  ///
  /// The company whose work requested the resource, read from the CRM project
  /// this reservation was raised against rather than from the request body.
  ///
  /// Stored rather than derived on every read, for two reasons. It lives in
  /// another service's database, so no query here can join to it. And it is a
  /// fact about a moment: a project that later moves to another company does
  /// not retroactively change who asked for a drill last March.
  ///
  /// NULL means UNKNOWN, never "everybody's" — 12 rows here point at projects
  /// that have since been deleted, and those keep saying so rather than being
  /// guessed into a company.
  ///
  /// The other half of the pair — who OWNS the stock — is deliberately NOT
  /// stored: it is the item's category's entityId, one enforced relation away,
  /// and a copy of it could drift the first time a category moves company.
  requesterWorkspaceId Int?

  quantity Float
  /// Task-side acceptance (2026-09-01 handshake): how much of the ISSUED
  /// quantity the task has confirmed receiving. Invariant accepted ≤ issued ≤
  /// requested; full acceptance of the requested quantity flips the
  /// reservation to COMPLETED — the status's first and only setter.
  acceptedQuantity  Float   @default(0)
  /// The task user's explanation when accepting less than what was issued
  /// (broken delivery, over-estimated request, …). Appended per acceptance and
  /// deliberately surfaced to warehouse staff.
  acceptanceComment String?

  status ResourceReservationStatus @default(PENDING)

  /// Which warehouse serves this reservation (#1989). NULL = main pool
  /// (Item.quantity) — every pre-1989 reservation and every non-task flow.
  /// Set from the task's backlog link at create; issuance, reclaims and
  /// returns then debit/credit THIS warehouse's stock.
  warehouseId Int?

  /// #2042: the task's construction object at create time — movements this
  /// reservation produces inherit it.
  objectId Int?

  startDate DateTime
  endDate   DateTime?

  notes String?

  replacedByReservationId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  replacedBy ResourceReservation?  @relation("ReservationReplacement", fields: [replacedByReservationId], references: [id])
  replaces   ResourceReservation[] @relation("ReservationReplacement")

  allocations ReservationAllocation[]

  allocationHistory ReservationAllocationHistory[]

  statusHistory ReservationStatusHistory[]

  returns ResourceReturn[]

  @@index([itemId])
  @@index([taskId])
  @@index([projectId])
  @@index([entityId])
  @@index([requesterWorkspaceId])
  @@index([status])
  @@index([startDate, endDate])
}

model ReservationStatusHistory {
  id Int @id @default(autoincrement())

  reservationId Int

  fromStatus ResourceReservationStatus?
  toStatus   ResourceReservationStatus

  previousQuantity Float?
  newQuantity      Float?

  performedBy Int?

  reason String?

  performedAt DateTime @default(now())

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([performedAt])
}

model ReservationAllocation {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int

  assetId Int?

  quantity Float @default(1)

  allocatedAt DateTime @default(now())

  allocatedBy Int?

  releasedAt DateTime?

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([assetId])
  @@index([releasedAt])
}

model ReservationAllocationHistory {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int

  assetId Int?

  action ReservationAllocationAction

  performedBy Int?

  notes String?

  performedAt DateTime @default(now())

  // RELATIONS

  reservation ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([assetId])
  @@index([action])
}

model Maintainer {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name           String
  phone          String?
  email          String?
  address        String?
  actingAddress  String?
  managers       Json?
  bankName       String?
  bankAccount    String?
  registryNumber String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceRecord {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  assetId Int

  maintainerId Int?

  status MaintenanceStatus @default(DRAFT)

  amount Float?

  /// Deposit the maintainer wants before starting. Raised as its own finance
  /// transfer when the job is submitted; the balance transfer covers the rest.
  prepaymentAmount Float?

  /// The balance transfer — kept on this field so every existing path that
  /// reads financeTransferId keeps working.

  financeTransferId    Int?
  prepaymentTransferId Int?

  /// Which submission attempt the finance operation keys belong to.
  ///
  /// Constant at 1 today, on purpose: `finalize` accepts only a DRAFT record
  /// and nothing moves a FINANCE_REJECTED one back to DRAFT, so a maintenance
  /// job cannot be resubmitted after finance refuses it. The column exists so
  /// that if such a path is ever added, bumping this is the whole change — the
  /// alternative is a reopened job silently reusing a spent key.
  financeAttempt       Int      @default(1)

  /// Why finance turned the job down. See ProcurementOrder for the same field —
  /// finance sends this on the rejection callback and it was being discarded.
  financeRejectionReason String?

  startDate DateTime
  endDate   DateTime?

  type String?

  notes String?

  createdBy Int?

  createdAt DateTime @default(now())

  // RELATIONS

  asset      Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintainer Maintainer? @relation(fields: [maintainerId], references: [id])

  @@index([assetId])
  @@index([maintainerId])
  @@index([startDate, endDate])
}

model AssetResponsibility {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  assetId Int

  userId Int

  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  assignedBy Int?

  notes String?

  createdAt DateTime @default(now())

  // RELATIONS

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@index([releasedAt])
}

model Supplier {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name           String
  email          String?
  phone          String?
  address        String?
  actingAddress  String?
  managers       Json?
  bankName       String?
  bankAccount    String?
  registryNumber String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  procurementOrders  ProcurementOrder[]
  inventoryMovements InventoryMovement[]
  supplierItems      SupplierItem[]
}

model SupplierItem {
  id         Int   @id @default(autoincrement())
  supplierId Int
  itemId     Int
  unitPrice  Float

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, itemId])
  @@index([supplierId])
  @@index([itemId])
}

model ProcurementOrder {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  status ProcurementOrderStatus @default(DRAFT)

  /// Order approval before finance (2026-09-25): who sent it, who approved
  /// it, or who sent it back to draft and why.
  submittedForApprovalBy  Int?
  submittedForApprovalAt  DateTime?
  approvedBy              Int?
  approvedAt              DateTime?
  approvalRejectedBy      Int?
  approvalRejectedAt      DateTime?
  approvalRejectionReason String?

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  notes             String?
  /// Which organization the purchase is for. Stamped from the buyer's active
  /// organization at create; a super-admin may correct it later, including on
  /// orders placed before this existed (hence nullable). Travels to finance so
  /// the spend is reported against the right organization.
  entityId          Int?
  /// Deposit the supplier requires before shipping. Raised as its own finance
  /// transfer at finalize; the balance transfer is what remains after it.
  prepaymentAmount  Float?
  createdBy         Int?
  financeTransferId Int?

  /// Which submission attempt the finance operation keys belong to.
  ///
  /// `resubmit` is a deliberate business decision to raise the money again
  /// after finance refused it, so it increments this and the next finalize
  /// carries fresh keys. A `finalize` that failed halfway does NOT — the order
  /// is still on the same attempt, and retrying it must land on the transfers
  /// that were already created rather than beside them.
  financeAttempt    Int       @default(1)

  /// Why finance turned the order down. Finance has always sent this on the
  /// rejection callback; there was nowhere to put it, so the warehouse showed a
  /// red status and no reason, and the only way to find out was to ask finance.
  /// Cleared on approval and on resubmission so a stale reason cannot linger.
  financeRejectionReason String?

  /// Receipt/receivedAt of the FIRST delivery, kept so existing list views and
  /// the finance flow keep working unchanged. Per-delivery documents live on
  /// ProcurementDelivery.
  receiptUrl String?
  receivedAt DateTime?

  /// Set when the order was settled short — the outstanding quantity is not
  /// coming. Paired with status CLOSED_SHORT.
  closedShortAt     DateTime?
  closedShortReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      ProcurementOrderItem[]
  deliveries ProcurementDelivery[]
  payments   ProcurementPayment[]
  /// Requisitions this order was raised for (#1885 sprint).
  requisitions PurchaseRequisition[]

  @@index([supplierId])
  @@index([entityId])
  @@index([status])
}

/// #1885/#1888-#1894 — the demand side of procurement: any department files
/// a requisition (what to buy, how much, for when); procurement reviews it
/// and converts it into a ProcurementOrder (which carries supplier/prices —
/// the requisition deliberately does not). Lines may name items not yet in
/// the catalog; procurement resolves them before approval.
enum PurchaseRequisitionStatus {
  DRAFT
  /// Sent by the requester, waiting for the organization's approver
  /// (approve_purchase_requisition) — procurement does not see it yet.
  PENDING_APPROVAL
  SUBMITTED
  IN_REVIEW
  APPROVED
  /// A rejection (by the organization or by procurement) waiting for
  /// confirm_requisition_rejection; declined, it returns where it was.
  REJECTION_PENDING
  REJECTED
  CANCELLED
  FULFILLED
}

model PurchaseRequisition {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  status PurchaseRequisitionStatus @default(DRAFT)

  title       String?
  comment     String?
  /// #1888: the period the goods are needed for.
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  /// Requester's active entity (x-entity-id) — informational.
  entityId  Int?
  createdBy Int

  /// #1893/#1894: the CRM task this requisition serves — either the task
  /// created FROM it or an existing task it was attached to.
  taskId     Int?
  taskOrigin String? // CREATED | ATTACHED

  /// The order procurement raised for it (approve = convert).
  orderId Int?
  order   ProcurementOrder? @relation(fields: [orderId], references: [id])

  rejectionReason String?
  reviewedBy      Int?
  reviewedAt      DateTime?

  /// The organization's approval decision (2026-09-11): who let it through
  /// to procurement — or, when status is REJECTED with reviewedBy empty,
  /// who turned it down before procurement ever saw it.
  decidedBy Int?
  decidedAt DateTime?

  /// Rejection confirmation (2026-09-25): who asked for the rejection and at
  /// which stage (ORG | PROCUREMENT), where it returns to if declined, who
  /// confirmed it, and the confirmer's note when it was declined.
  rejectionRequestedBy  Int?
  rejectionRequestedAt  DateTime?
  rejectionStage        String?
  rejectionReturnStatus PurchaseRequisitionStatus?
  rejectionConfirmedBy  Int?
  rejectionConfirmedAt  DateTime?
  rejectionDeclineNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       PurchaseRequisitionLine[]
  comments    PurchaseRequisitionComment[]
  attachments PurchaseRequisitionAttachment[]

  @@index([createdBy])
  @@index([status])
  @@index([taskId])
  @@index([orderId])
}

model PurchaseRequisitionLine {
  id            Int @id @default(autoincrement())
  requisitionId Int

  /// Catalog item once known (picked at creation or resolved by procurement).
  itemId   Int?
  /// Free text is allowed — the item may not exist yet (#1888).
  itemName String
  /// Auto-filled from the catalog, editable (#1888).
  code     String?
  unit     ItemUnit?
  quantity Float

  /// Snapshots at creation, for the form's context (#1888): on hand, and
  /// already-ordered-not-received. Not recomputed later.
  stockQuantity    Float?
  expectedQuantity Float?
  note             String?
  /// The reservation this line was raised for, when the request came from a
  /// short reservation (2026-09-16). Cross-table pointer, no FK: a cancelled
  /// reservation must not take the request's history with it.
  reservationId    Int?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item?               @relation(fields: [itemId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
  @@index([reservationId])
}

model PurchaseRequisitionComment {
  id            Int      @id @default(autoincrement())
  requisitionId Int
  userId        Int
  text          String
  createdAt     DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

model PurchaseRequisitionAttachment {
  id            Int      @id @default(autoincrement())
  requisitionId Int
  uploadedBy    Int?
  name          String
  url           String
  size          Int
  mimeType      String
  createdAt     DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

model ProcurementOrderItem {
  id      Int @id @default(autoincrement())
  orderId Int
  itemId  Int

  quantity  Float
  unitPrice Float?
  /// The price on the supplier's invoice, when it differed from the ordered
  /// one (entered at receipt or by a later amendment). Null = as ordered.
  invoicedUnitPrice Float?

  /// Cached rollup of this line's ProcurementDeliveryItem quantities. Derivable,
  /// but kept denormalised so list views and the "remaining" column don't have
  /// to aggregate deliveries on every read.
  receivedQuantity Float @default(0)

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deliveryItems ProcurementDeliveryItem[]

  @@index([orderId])
  @@index([itemId])
}

/// One physical delivery against an order. Orders can arrive in instalments,
/// and each instalment comes with its own receipt/waybill — which is why this
/// is a table rather than a counter on the order.
model ProcurementDelivery {
  id      Int @id @default(autoincrement())
  orderId Int

  receiptUrl String?
  /// Number of the accompanying paper (invoice/waybill). Required by the API
  /// on every new delivery; nullable only for rows recorded before the field.
  documentNumber String?
  notes      String?
  receivedBy Int?
  receivedAt DateTime @default(now())

  order ProcurementOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ProcurementDeliveryItem[]

  @@index([orderId])
}

model ProcurementDeliveryItem {
  id          Int @id @default(autoincrement())
  deliveryId  Int
  orderItemId Int

  quantity Float
  /// Unit price on the document that came with this delivery, if entered.
  unitPrice Float?

  delivery  ProcurementDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem ProcurementOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([orderItemId])
}

/// A settlement against an order. Today an order has at most one BALANCE row;
/// the prepayment work will add a PREPAYMENT row settled before delivery.
/// Replaces the single ProcurementOrder.financeTransferId, which could not
/// represent more than one payment.
model ProcurementPayment {
  id      Int @id @default(autoincrement())
  orderId Int

  type   ProcurementPaymentType
  amount Float

  /// finance-api Transfer id. The finance callback identifies which payment it
  /// refers to by this, since both payments call back on the same order URL.
  financeTransferId Int?
  status            String @default("PENDING")
  /// Why this money exists, for corrections: the reason given and the
  /// supplier's document it came from, and who entered it.
  note           String?
  documentNumber String?
  createdBy      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([financeTransferId])
}

model ItemCategory {
  id Int @id @default(autoincrement())

  name String

  entityId Int @default(1)

  parentId Int?

  position Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  parent ItemCategory? @relation("ItemCategoryHierarchy", fields: [parentId], references: [id])

  children ItemCategory[] @relation("ItemCategoryHierarchy")

  items Item[]

  @@index([entityId])
}

model ResourceReturn {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  reservationId Int
  reservation   ResourceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  quantity Float

  status ResourceReturnStatus @default(PENDING)

  notes String?

  requestedBy Int?
  receivedBy  Int?

  requestedAt DateTime  @default(now())
  receivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([status])
}

/// One write, carried out once, however many times it is asked for.
///
/// The transport between a caller and this service is not reliable: a request
/// can commit here and its answer never arrive, and the caller — an assistant,
/// a browser on a flaky connection, a proxy that retries — has no way to tell
/// that apart from a request that never landed. Asking again is the obvious
/// thing to do and, for a create, it makes a second row.
///
/// So a caller may name its intent with an opaque `Idempotency-Key`, and this
/// table remembers what that intent produced. Repeating it replays the first
/// answer instead of doing the work twice.
///
/// The status matters more than it looks. It is flipped to SUCCEEDED INSIDE the
/// same transaction as the business write, so the two facts cannot disagree:
/// a row still saying IN_FLIGHT after a crash is proof the write did not
/// commit, which is what makes it safe to let a later attempt take the lease
/// over rather than refusing forever.
model WriteOperation {
  id Int @id @default(autoincrement())

  /// The caller's opaque key. Unique across the service, which is what makes
  /// the database — not this code — decide which concurrent attempt proceeds.
  key String @unique

  /// Who claimed it. A key belongs to the person who took it; nobody else can
  /// redeem it, so a leaked key cannot replay somebody else's write back at
  /// them or act in their name.
  userId Int

  /// The workspace they were acting as, when they declared one.
  entityId Int?

  /// Method and path, so the same key cannot be reused for a different action.
  route String

  /// SHA-256 of the canonicalised request body. The same key with a different
  /// body is a mistake worth reporting, not a replay to serve.
  fingerprint String

  /// IN_FLIGHT or SUCCEEDED. A failure releases the key instead of recording
  /// one, so a corrected retry is not blocked by a refused attempt.
  status String @default("IN_FLIGHT")

  /// What the first attempt answered, replayed verbatim to the ones after it.
  result Json?

  /// The row that was written, when there was one — for the trail, and for
  /// anyone reconciling by hand.
  resourceId Int?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([createdAt])
}

// ── Asset custody (2026-09-23) ───────────────────────────────────────────────
// Who holds an asset, and how it got there. Replaces AssetResponsibility (kept
// dormant; its rows were copied in by the migration). A holder is a person or
// a construction object; an object's custody is permanent from the warehouse's
// point of view, a person's ends with a return.

enum AssetHolderType {
  USER
  OBJECT
}

enum AssetCustodyVia {
  TASK_ALLOCATION
  PERSONAL_REQUEST
  DIRECT_ISSUE
  OBJECT_REASSIGN
}

enum AssetRequestKind {
  PERSONAL
  OBJECT
}

enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

enum AssetReleaseCondition {
  OK
  DAMAGED
  LOST
}

model AssetRequest {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  kind AssetRequestKind @default(PERSONAL)

  /// Organisation the request is filed in (the requester's workspace).
  entityId Int?

  requestedBy Int
  forUserId   Int?
  forObjectId Int?

  itemId   Int
  quantity Int @default(1)
  reason   String?

  status       AssetRequestStatus @default(PENDING)
  decidedBy    Int?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item      Item           @relation(fields: [itemId], references: [id])
  custodies AssetCustody[]

  @@index([forUserId])
  @@index([forObjectId])
  @@index([status])
  @@index([requestedBy])
}

model AssetCustody {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  assetId Int

  holderType     AssetHolderType @default(USER)
  holderUserId   Int?
  holderObjectId Int?
  /// An asset given to an object and then to a person keeps its object; a
  /// return from that person goes back to the object, not to the warehouse.
  originObjectId Int?

  via           AssetCustodyVia @default(DIRECT_ISSUE)
  requestId     Int?
  reservationId Int?

  assignedBy Int?
  assignedAt DateTime  @default(now())
  /// The holder confirmed receipt (mandatory for people).
  acceptedAt DateTime?

  releasedAt       DateTime?
  releasedBy       Int?
  releaseCondition AssetReleaseCondition?
  notes            String?

  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  request AssetRequest? @relation(fields: [requestId], references: [id])

  @@index([assetId])
  @@index([holderUserId])
  @@index([holderObjectId])
  @@index([releasedAt])
}
